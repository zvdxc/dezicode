// Currently connected device
ESPNowDevice* connectedDevice = nullptr;
unsigned long lastConnectionTime = 0;
const unsigned long CONNECTION_TIMEOUT = 10000; // 10 seconds timeout
bool isConnected = false;

void showDeviceOptions(int deviceIndex) {
  if (deviceIndex < 0 || deviceIndex >= foundDevices.size()) {
    return;
  }

  // Store the selected device
  if (connectedDevice) {
    delete connectedDevice;
  }
  connectedDevice = new ESPNowDevice(foundDevices[deviceIndex]);

  currentScreen = ESP_NOW_DEVICE_SCREEN;

  tft.fillScreen(TFT_WHITE);
  tft.setTextColor(TFT_BLACK, TFT_WHITE);

  // Device header
  tft.drawCentreString("Device Options", tft.width()/2, 10, 4);

  // Device info
  tft.drawString("Name: " + connectedDevice->name, 20, 50, 2);
  tft.drawString("RSSI: " + String(connectedDevice->rssi) + " dBm", 20, 80, 2);

  // Format MAC address
  char macStr[18];
  snprintf(macStr, sizeof(macStr), "%02X:%02X:%02X:%02X:%02X:%02X",
           connectedDevice->mac[0], connectedDevice->mac[1], connectedDevice->mac[2],
           connectedDevice->mac[3], connectedDevice->mac[4], connectedDevice->mac[5]);
  tft.drawString("MAC: " + String(macStr), 20, 110, 2);

  // Action buttons
  int buttonY = 150;

  // Connect button
  tft.drawRect(40, buttonY, 240, 35, TFT_GREEN);
  tft.fillRect(41, buttonY + 1, 238, 33, TFT_GREEN);
  tft.setTextColor(TFT_WHITE, TFT_GREEN);
  tft.drawCentreString("Connect to Device", tft.width()/2, buttonY + 10, 2);

  buttonY += 45;

  // Back button
  tft.drawRect(40, buttonY, 240, 35, TFT_RED);
  tft.fillRect(41, buttonY + 1, 238, 33, TFT_RED);
  tft.setTextColor(TFT_WHITE, TFT_RED);
  tft.drawCentreString("Back to List", tft.width()/2, buttonY + 10, 2);

  tft.setTextColor(TFT_BLACK, TFT_WHITE);
}

void connectToDevice(ESPNowDevice& device) {
  // Store the connected device
  if (connectedDevice) {
    delete connectedDevice;
  }
  connectedDevice = new ESPNowDevice(device);

  // Disable WiFi but keep ESP-NOW
  disableWiFiKeepESPNow();

  // Initialize ESP-NOW
  if (esp_now_init() != ESP_OK) {
    Serial.println("Error initializing ESP-NOW");
    return;
  }

  // Register callback for data reception
  esp_now_register_recv_cb(OnDataRecv);

  // Add peer
  esp_now_peer_info_t peerInfo;
  memcpy(peerInfo.peer_addr, device.mac, 6);
  peerInfo.channel = 1; // Use channel 1 for ESP-NOW
  peerInfo.encrypt = false;

  if (esp_now_add_peer(&peerInfo) != ESP_OK) {
    Serial.println("Failed to add peer");
    return;
  }

  // Set connection state
  isConnected = true;
  lastConnectionTime = millis();

  Serial.println("Connected to device");

  // Show connected device screen
  showConnectedDeviceScreen();
}

void showConnectedDeviceScreen() {
  if (!connectedDevice) return;

  currentScreen = DEVICE_CONNECTED_SCREEN;
  tft.fillScreen(TFT_WHITE);
  tft.setTextColor(TFT_BLACK, TFT_WHITE);

  // Header
  tft.drawCentreString("Connected Device", tft.width()/2, 20, 4);

  // Device info
  tft.drawString("Name: " + connectedDevice->name, 20, 60, 2);

  // Format MAC address
  char macStr[18];
  snprintf(macStr, sizeof(macStr), "%02X:%02X:%02X:%02X:%02X:%02X",
           connectedDevice->mac[0], connectedDevice->mac[1], connectedDevice->mac[2],
           connectedDevice->mac[3], connectedDevice->mac[4], connectedDevice->mac[5]);
  tft.drawString("MAC: " + String(macStr), 20, 90, 2);

  // Connection status
  updateConnectionStatus();

  // Last seen
  tft.drawString("Last seen: ", 20, 150, 2);

  // Back button
  int buttonY = tft.height() - 60;
  tft.drawRect(40, buttonY, 240, 40, TFT_RED);
  tft.fillRect(41, buttonY + 1, 238, 38, TFT_RED);
  tft.setTextColor(TFT_WHITE, TFT_RED);
  tft.drawCentreString("Disconnect", tft.width()/2, buttonY + 12, 2);

  tft.setTextColor(TFT_BLACK, TFT_WHITE);
}

void updateConnectionStatus() {
  if (!connectedDevice) return;

  // Check connection timeout
  if (isConnected && (millis() - lastConnectionTime > CONNECTION_TIMEOUT)) {
    isConnected = false;
    tft.fillRect(20, 120, 200, 20, TFT_WHITE);
    tft.setTextColor(TFT_RED, TFT_WHITE);
    tft.drawString("Status: Disconnected", 20, 120, 2);
    return;
  }

  // Update last seen time
  unsigned long secondsAgo = (millis() - lastConnectionTime) / 1000;
  char timeStr[20];
  if (secondsAgo < 60) {
    snprintf(timeStr, sizeof(timeStr), "%lu seconds ago", secondsAgo);
  } else {
    snprintf(timeStr, sizeof(timeStr), "%lu minutes ago", secondsAgo / 60);
  }

  tft.fillRect(100, 150, 200, 20, TFT_WHITE);
  tft.drawString(timeStr, 100, 150, 2);

  // Update connection status
  tft.fillRect(20, 120, 200, 20, TFT_WHITE);
  tft.setTextColor(isConnected ? TFT_GREEN : TFT_RED, TFT_WHITE);
  tft.drawString(isConnected ? "Status: Connected" : "Status: Disconnected", 20, 120, 2);
  tft.setTextColor(TFT_BLACK, TFT_WHITE);
}

// ESP-NOW receive callback
void OnDataRecv(const esp_now_recv_info_t *info, const uint8_t *data, int data_len) {
  if (!info || !data || data_len <= 0) return;

  // Update last connection time when receiving data
  if (connectedDevice && memcmp(connectedDevice->mac, info->src_addr, 6) == 0) {
    lastConnectionTime = millis();
    if (!isConnected) {
      isConnected = true;
      if (currentScreen == DEVICE_CONNECTED_SCREEN) {
        updateConnectionStatus();
      }
    }
  }
}

// ESP-NOW scan callback
void onScanDone(arduino_event_id_t event, arduino_event_info_t info) {
  isScanning = false;
  foundDevices.clear();

  // Get scan results
  int16_t count = WiFi.scanComplete();
  Serial.print("Scan complete. Found networks: ");
  Serial.println(count);

  if (count < 0) {
    Serial.println("No scan results available");
    return;
  }

  bool foundDeziDuino = false;

  // Print all found networks for debugging
  for (int i = 0; i < count; i++) {
    String ssid = WiFi.SSID(i);
    String bssid = WiFi.BSSIDstr(i);
    int32_t rssi = WiFi.RSSI(i);

    // Print network info
    Serial.printf("Network %d: SSID: '%s', BSSID: %s, RSSI: %d\n",
                 i, ssid.c_str(), bssid.c_str(), rssi);

    // Check if this is a DeziDuino device (case insensitive check)
    if (ssid.length() > 0) {  // Only process non-hidden networks
      String ssidUpper = ssid;
      ssidUpper.toUpperCase();

      // Look for DeziDuino or ESP devices
      if (ssidUpper.startsWith("DEZIDUINO") || ssidUpper.startsWith("ESP")) {
        ESPNowDevice device;

        // Parse MAC address from BSSID string (format: "XX:XX:XX:XX:XX:XX")
        uint8_t mac[6];
        if (sscanf(bssid.c_str(), "%hhx:%hhx:%hhx:%hhx:%hhx:%hhx",
                  &mac[0], &mac[1], &mac[2], &mac[3], &mac[4], &mac[5]) == 6) {
          memcpy(device.mac, mac, 6);
          device.name = ssid;  // Keep original case for display
          device.rssi = rssi;
          foundDevices.push_back(device);
          foundDeziDuino = true;

          // Debug output
          char macStr[18];
          snprintf(macStr, sizeof(macStr), "%02X:%02X:%02X:%02X:%02X:%02X",
                  mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
          Serial.printf("-> Found ESP-NOW device: %s (%s) %d dBm\n",
                       ssid.c_str(), macStr, rssi);
        }
      }
    }
  }

  if (!foundDeziDuino) {
    Serial.println("No DeziDuino devices found in scan results");
  }

  // If we're on the ESP-NOW scan screen, update the display
  if (currentScreen == ESP_NOW_SCAN_SCREEN) {
    drawESPNowDeviceList();
  }

  // Try to restore WiFi connection if needed
  if (wifiWasConnected) {
    Serial.println("Attempting to restore WiFi connection...");
    WiFi.reconnect();
  }
}

// Draw the list of found ESP-NOW devices
void drawESPNowDeviceList() {
  tft.fillScreen(TFT_WHITE);
  tft.setTextColor(TFT_BLACK, TFT_WHITE);
  tft.drawCentreString("Select Device", tft.width()/2, 10, 4);

  if (foundDevices.empty()) {
    tft.drawCentreString("No devices found", tft.width()/2, 50, 2);
    tft.drawCentreString("Scanning...", tft.width()/2, 80, 2);
  } else {
    // Display found devices (up to 4 to fit on screen with spacing)
    for (int i = 0; i < foundDevices.size() && i < 4; i++) {
      int y = 40 + (i * 45);

      // Draw device button
      tft.drawRect(20, y, tft.width() - 40, 40, TFT_BLUE);
      tft.fillRect(21, y + 1, tft.width() - 42, 38, TFT_WHITE);

      // Device name and signal strength
      String deviceStr = foundDevices[i].name;
      String rssiStr = String(foundDevices[i].rssi) + " dBm";

      tft.setTextColor(TFT_BLUE, TFT_WHITE);
      tft.drawString(deviceStr, 30, y + 10, 2);
      tft.setTextColor(TFT_DARKGREY, TFT_WHITE);
      tft.drawString(rssiStr, 30, y + 25, 1);

      // Draw arrow
      tft.fillTriangle(tft.width() - 30, y + 15,
                      tft.width() - 20, y + 20,
                      tft.width() - 30, y + 25, TFT_BLUE);
    }
  }

  // Back button (bottom left)
  tft.drawRect(20, tft.height() - 50, 120, 35, TFT_RED);
  tft.setTextColor(TFT_RED, TFT_WHITE);
  tft.drawCentreString("BACK", 80, tft.height() - 40, 2);

  tft.setTextColor(TFT_BLACK, TFT_WHITE);
}

// Start ESP-NOW device scan
void startESPNowScan() {
  if (isScanning) {
    Serial.println("Scan already in progress");
    return;
  }

  isScanning = true;
  foundDevices.clear();

  // Save current WiFi state
  bool wasConnected = (WiFi.status() == WL_CONNECTED);
  String currentSSID = WiFi.SSID();
  String currentPSK = "";  // Can't retrieve PSK, will need to reconnect manually

  // Disconnect WiFi but keep the configuration
  WiFi.disconnect(false);
  delay(100);

  // Set WiFi to station mode
  WiFi.mode(WIFI_STA);

  // Configure WiFi to channel 1
  esp_wifi_set_promiscuous(true);
  esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);
  esp_wifi_set_promiscuous(false);

  // Register scan done callback
  WiFi.onEvent(onScanDone, ARDUINO_EVENT_WIFI_SCAN_DONE);

  // Start the scan
  Serial.println("Starting network scan on channel 1...");
  bool scanStarted = WiFi.scanNetworks(true, true, false, 500, 1);

  if (!scanStarted) {
    Serial.println("Failed to start scan");
    isScanning = false;

    // Try to restore WiFi connection
    if (wasConnected) {
      WiFi.begin(currentSSID.c_str(), currentPSK.c_str());
    }
    return;
  }

  // Show scanning screen
  currentScreen = ESP_NOW_SCAN_SCREEN;
  tft.fillScreen(TFT_WHITE);
  tft.drawCentreString("Scanning...", tft.width()/2, 50, 2);
  Serial.println("Scan started on channel 1");
}

// First loop() function removed - using the more complete version below
        }
      } else if (currentScreen == SETTINGS_SCREEN) {
        // WiFi Setup button
        if (isInRect(touchX, touchY, 40, 40, 240, 35)) {
          currentScreen = WIFI_CONFIG_SCREEN;
          wifiManager.startAP();
          drawWiFiConfigScreen();
        }
        // ESP-NOW Setup button
        else if (isInRect(touchX, touchY, 40, 85, 240, 35)) {
          disableWiFiKeepESPNow();
          startESPNowScan();
        }
        // Exit button - will trigger reboot
        else if (isInRect(touchX, touchY, 40, 200, 240, 35)) {
          tft.fillScreen(TFT_WHITE);
          tft.setTextColor(TFT_BLACK, TFT_WHITE);
          tft.drawCentreString("Saving settings...", tft.width()/2, tft.height()/2 - 20, 2);
          tft.drawCentreString("Rebooting...", tft.width()/2, tft.height()/2 + 10, 2);
          saveSettings();
          delay(1000);
          ESP.restart();
        }
      } else if (currentScreen == WIFI_CONFIG_SCREEN) {
        // Back button
        if (isInRect(touchX, touchY, 40, 160, 240, 40)) {
          currentScreen = SETTINGS_SCREEN;
          drawSettingsScreen();
        }
      } else if (currentScreen == ESP_NOW_DEVICE_SCREEN) {
        // Connect button
        if (isInRect(touchX, touchY, 40, 150, 240, 35)) {
          // Connect to the selected device
          if (!foundDevices.empty()) {
            // Find which device is selected
            for (int i = 0; i < foundDevices.size(); i++) {
              if (foundDevices[i].name == connectedDevice->name) {
                connectToDevice(foundDevices[i]);
                break;
              }
            }
          }
        }
        // Back button
        else if (isInRect(touchX, touchY, 40, 200, 240, 35)) {
          currentScreen = ESP_NOW_SCAN_SCREEN;
          drawESPNowDeviceList();
        }
      } else if (currentScreen == ESP_NOW_SCAN_SCREEN) {
        // Handle device selection
        if (!foundDevices.empty()) {
          for (int i = 0; i < foundDevices.size() && i < 4; i++) {
            int y = 40 + (i * 45);
            if (isInRect(touchX, touchY, 20, y, tft.width() - 40, 40)) {
              showDeviceOptions(i);
              break;
            }
          }
        }

        // Back button (bottom left)
        if (isInRect(touchX, touchY, 20, tft.height() - 50, 120, 35)) {
          currentScreen = SETTINGS_SCREEN;
          drawSettingsScreen();
        }
      } else if (currentScreen == DEVICE_CONNECTED_SCREEN) {
        // Disconnect button
        if (isInRect(touchX, touchY, 40, tft.height() - 60, 240, 40)) {
          // Disconnect from device
          if (connectedDevice) {
            delete connectedDevice;
            connectedDevice = nullptr;
          }
          currentScreen = SETTINGS_SCREEN;
          drawSettingsScreen();
        }
      }
    }
  } else if (!isTouched) {
    // Touch released
    touchActive = false;
  }

  // Update connection status if on the connected device screen
  static unsigned long lastUpdate = 0;
  if (currentScreen == DEVICE_CONNECTED_SCREEN && connectedDevice) {
    if (millis() - lastUpdate > 1000) { // Update every second
      updateConnectionStatus();
      lastUpdate = millis();
    }
  }

  // Handle WiFi client in AP mode
  if (currentScreen == WIFI_CONFIG_SCREEN) {
    wifiManager.handleClient();
  } else if (currentScreen == SETTINGS_SCREEN || currentScreen == ESP_NOW_SCAN_SCREEN) {
    // If we're in settings or ESP-NOW scan, make sure WiFi is disabled
    if (WiFi.status() == WL_CONNECTED) {
      disableWiFiKeepESPNow();
    }
  // Handle other screens
  if (currentScreen == MAIN_SCREEN) {
    // Update main screen if needed
    static unsigned long lastUpdate = 0;
    if (millis() - lastUpdate > 1000) {
      // Update time or other dynamic content
      lastUpdate = millis();
    }
  }

  // Periodically check WiFi status, but only if we're on the main screen
  unsigned long currentTime = millis();
  if (currentTime - lastWifiCheck > WIFI_CHECK_INTERVAL) {
    // Only attempt to reconnect if we're on the main screen
    if (currentScreen == MAIN_SCREEN && wifiManager.isConfigured() && !wifiManager.isAPMode()) {
      if (WiFi.status() != WL_CONNECTED) {
        bool connected = wifiManager.connect();
        if (connected) {
          Serial.println("Reconnected to WiFi");
          drawMainScreen();
        } else {
          Serial.println("Failed to reconnect to WiFi");
        }
      }
    }
    lastWifiCheck = currentTime;
  }
}


void setup() {
  // Initialize serial communication
  Serial.begin(115200);
  while (!Serial); // Wait for serial port to connect

  // Initialize display
  tft.init();
  tft.setRotation(1); // Landscape mode
  tft.fillScreen(TFT_WHITE);
  tft.setTextColor(TFT_BLACK, TFT_WHITE);
  tft.setTextSize(1);

  // Initialize touch controller
  mySpi.begin(XPT2046_CLK, XPT2046_MISO, XPT2046_MOSI, XPT2046_CS);
  ts.begin(mySpi);
  ts.setRotation(1);  // Match display rotation

  // Try to connect to WiFi if configured
  tft.drawCentreString("Connecting to WiFi...", tft.width()/2, 50, 2);
  if (wifiManager.isConfigured()) {
    if (wifiManager.connect()) {
      tft.drawCentreString("Connected to WiFi!", tft.width()/2, 70, 2);
      Serial.println("Connected to WiFi");
      Serial.print("IP Address: ");
      Serial.println(WiFi.localIP());

      // Initialize ESP-NOW after WiFi is connected
      if (esp_now_init() != ESP_OK) {
        Serial.println("Error initializing ESP-NOW");
      } else {
        Serial.println("ESP-NOW initialized");
      }
    } else {
      tft.drawCentreString("WiFi Connect Failed", tft.width()/2, 70, 2);
      Serial.println("WiFi connection failed");

      // Still try to initialize ESP-NOW even if WiFi connection failed
      if (esp_now_init() != ESP_OK) {
        Serial.println("Error initializing ESP-NOW");
      } else {
        Serial.println("ESP-NOW initialized (WiFi failed)");
      }
    }
  } else {
    tft.drawCentreString("No WiFi Config", tft.width()/2, 70, 2);
    Serial.println("No WiFi configuration found");

    // Initialize ESP-NOW even without WiFi config
    if (esp_now_init() != ESP_OK) {
      Serial.println("Error initializing ESP-NOW");
    } else {
      Serial.println("ESP-NOW initialized (no WiFi config)");
    }
  }

  // Draw the initial screen
  delay(1000); // Show status messages for a moment
  drawMainScreen();

  Serial.println("Setup complete - Touch the screen to test");
  lastWifiCheck = millis();
}

void loop() {
  // Update decibel value periodically, but only on the main screen
  if (currentScreen == MAIN_SCREEN && WiFi.status() == WL_CONNECTED) {
    if (millis() - lastDecibelUpdate >= DECIBEL_UPDATE_INTERVAL) {
      if (fetchDecibelValueN8N()) {
        drawMainScreen();
      } else {
        Serial.println("Failed to fetch decibel value from webhook");
      }
      lastDecibelUpdate = millis();
    }
  }

  // Check WiFi connection status periodically
  if (millis() - lastWifiCheck >= WIFI_CHECK_INTERVAL) {
    if (WiFi.status() != WL_CONNECTED && currentScreen != WIFI_CONFIG_SCREEN) {
      Serial.println("WiFi disconnected, trying to reconnect...");
      if (WiFi.reconnect()) {
        Serial.println("Successfully reconnected to WiFi");
        drawMainScreen();
      } else {
        Serial.println("Failed to reconnect to WiFi");
      }
    }
    lastWifiCheck = millis();
  }

  // Update connection status if on the connected device screen
  if (currentScreen == DEVICE_CONNECTED_SCREEN) {
    updateConnectionStatus();
  }

  // Handle touch input
  if (ts.tirqTouched() && ts.touched()) {
    TS_Point p = ts.getPoint();

    // Map touch coordinates to screen coordinates (adjust these values based on your calibration)
    int16_t touchX = map(p.x, TS_MINX, TS_MAXX, 0, tft.width());
    int16_t touchY = map(p.y, TS_MINY, TS_MAXY, 0, tft.height());

    // Debug output
    Serial.print("Touch at X = ");
    Serial.print(touchX);
    Serial.print(", Y = ");
    Serial.println(touchY);

    // Handle touch based on current screen
    if (currentScreen == MAIN_SCREEN) {
      // Check if settings icon was touched
      if (isInRect(touchX, touchY, tft.width() - 40, 0, 40, 40)) {
        currentScreen = SETTINGS_SCREEN;
        drawSettingsScreen();
      }
    } else if (currentScreen == SETTINGS_SCREEN) {
      // Back button
      if (isInRect(touchX, touchY, 20, tft.height() - 50, 120, 35)) {
        currentScreen = MAIN_SCREEN;
        drawMainScreen();
      }
      // WiFi Config button
      else if (isInRect(touchX, touchY, 40, 80, 240, 40)) {
        currentScreen = WIFI_CONFIG_SCREEN;
        drawWiFiConfigScreen();
      }
      // ESP-NOW Scan button
      else if (isInRect(touchX, touchY, 40, 140, 240, 40)) {
        startESPNowScan();
      }
    } else if (currentScreen == WIFI_CONFIG_SCREEN) {
      // Back button
      if (isInRect(touchX, touchY, 20, tft.height() - 50, 120, 35)) {
        currentScreen = SETTINGS_SCREEN;
        drawSettingsScreen();
      }
    } else if (currentScreen == ESP_NOW_DEVICE_SCREEN) {
      // Connect button
      if (isInRect(touchX, touchY, 40, 150, 240, 35)) {
        // Connect to the selected device
        if (!foundDevices.empty()) {
          // Find which device is selected
          for (int i = 0; i < foundDevices.size(); i++) {
            if (foundDevices[i].name == connectedDevice->name) {
              connectToDevice(foundDevices[i]);
              break;
            }
          }
        }
      }
      // Back button
      else if (isInRect(touchX, touchY, 40, 200, 240, 35)) {
        currentScreen = ESP_NOW_SCAN_SCREEN;
        drawESPNowDeviceList();
      }
    } else if (currentScreen == ESP_NOW_SCAN_SCREEN) {
      // Handle device selection
      if (!foundDevices.empty()) {
        for (int i = 0; i < foundDevices.size() && i < 4; i++) {
          int y = 40 + (i * 45);
          if (isInRect(touchX, touchY, 20, y, tft.width() - 40, 40)) {
            showDeviceOptions(i);
            break;
          }
        }
      }

      // Back button (bottom left)
      if (isInRect(touchX, touchY, 20, tft.height() - 50, 120, 35)) {
        currentScreen = SETTINGS_SCREEN;
        drawSettingsScreen();
      }
    } else if (currentScreen == DEVICE_CONNECTED_SCREEN) {
      // Disconnect button
      if (isInRect(touchX, touchY, 40, tft.height() - 60, 240, 40)) {
        // Disconnect from device
        if (connectedDevice) {
          delete connectedDevice;
          connectedDevice = nullptr;
        }
        currentScreen = SETTINGS_SCREEN;
        drawSettingsScreen();
      }
    }
  }

  // Handle WiFi client in AP mode
  if (currentScreen == WIFI_CONFIG_SCREEN) {
    wifiManager.handleClient();
  }

  delay(50); // Small delay to prevent touch bounce
}