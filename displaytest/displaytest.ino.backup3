// WiFi state management
bool wifiWasConnected = false;

// Function to disable WiFi but keep ESP-NOW
void disableWiFiKeepESPNow() {
    // Save WiFi state before disconnecting
    wifiWasConnected = (WiFi.status() == WL_CONNECTED);

    // Disconnect and stop WiFi
    WiFi.disconnect(true);
    delay(100);

    // Initialize WiFi in STA mode (required for ESP-NOW)
    WiFi.mode(WIFI_STA);

    // Initialize ESP-NOW
    if (esp_now_init() != ESP_OK) {
        Serial.println("Error initializing ESP-NOW");
        return;
    }

    // Set primary WiFi channel to match the ESP-NOW channel (channel 1)
    esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);
}

// Function to enable WiFi and ESP-NOW
void enableWiFiAndESPNow() {
    // Stop any existing WiFi
    WiFi.disconnect(true);
    delay(100);

    // Start WiFi in station mode
    WiFi.mode(WIFI_STA);

    // Reconnect to WiFi if we were previously connected
    if (wifiWasConnected) {
        WiFi.reconnect();
    }

    // Initialize ESP-NOW if not already initialized
    if (esp_now_init() != ESP_OK) {
        Serial.println("Error initializing ESP-NOW");
        return;
    }

    // Set WiFi channel to auto (0) for normal WiFi operation
    esp_wifi_set_channel(0, WIFI_SECOND_CHAN_NONE);

    Serial.println("WiFi and ESP-NOW enabled");
}

// Function to restore WiFi if it was connected
void restoreWiFiIfNeeded() {
  if (wifiWasConnected) {
    WiFi.reconnect();
  }
}

